{
  "version": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 7766,
    "autoPort": false,
    "locale": "zh"
  },
  "daemon": {
    "enabled": true,
    "logLevel": "info"
  },
  "update": {
    "autoCheck": true,
    "channel": "stable",
    "checkIntervalHours": 24
  },
  "agent": {
    "defaultModel": "deepseek-chat",
    "maxTokens": 8192,
    "maxTurns": 0,
    "llmStreamIdleTimeoutMs": 900000,
    "workingDirectory": "",
    "codeMode": {
      "enabled": true,
      "presentation": "standard",
      "uiEnabled": true,
      "timeoutMs": 120000,
      "maxCodeChars": 20000,
      "maxOutputBytes": 262144,
      "maxParallelSubCalls": 10
    }
  },
  "context": {
    "compaction": {
      "enabled": true,
      "compactRatio": 0.80,
      "tailKeepRatio": 0.16,
      "summaryMaxTokens": 8192,
      "minFoldTokens": 400,
      "summaryModel": "inherit"
    },
    "toolPruning": {
      "enabled": true,
      "thresholdChars": 8192,
      "keepHeadChars": 4096,
      "keepTailChars": 1024
    },
    "healer": {
      "enabled": true,
      "toolNameFuzzy": true,
      "schemaFix": true
    },
    "telemetry": {
      "enabled": true
    }
  },
  "tools": {
    "read":      { "enabled": true },
    "write":     { "enabled": true, "requireConfirmation": true },
    "edit":      { "enabled": true, "requireConfirmation": false },
    "delete":    { "enabled": true, "requireConfirmation": true },
    "terminal":  { "enabled": true, "timeout": 30000, "requireConfirmation": true },
    "skill":     { "enabled": true },
    "mcp":       { "enabled": true },
    "memory":    { "enabled": true },
    "glob":      { "enabled": true },
    "grep":      { "enabled": true },
    "web":       { "enabled": true },
    "todo":      { "enabled": true },
    "ask":       { "enabled": true },
    "automation": { "enabled": true },
    "computer":  { "enabled": true, "requireConfirmation": true, "timeout": 120000, "maxImageDimension": 1280, "maxTreeElements": 250, "allowForeground": true },
    "browser":   { "enabled": true, "requireConfirmation": false, "timeoutMs": 30000, "bridgePort": 7799, "bridgeToken": "", "tabGroupTitle": "MOSS", "tabGroupColor": "blue", "maxSnapshotNodes": 800, "maxImageDimension": 1600, "browserPath": "", "autoDownloadChromeForTesting": false, "autoInstallExtensions": false, "allowEvaluate": true }
  },
  "mcpServers": {},
  "mcp": {
    "callTimeoutMs": 120000,
    "allowSampling": true
  },
  "mcpServer": {
    "enabled": false,
    "allowedTools": [],
    "responseMode": "sse",
    "exposeInternalTools": false,
    "trackSummary": true
  },
  "skills": {},
  "security": {
    "authToken": "",
    "bindLocalhostOnly": true
  }
}
