# webui 依赖安装策略
# legacy-peer-deps=true：
#   1) 不自动安装 peerDependencies —— @lobehub/icons 把 @lobehub/ui / antd 声明为 peer，
#      而项目只用其 es/<品牌> 图标模块（实测仅 import react）。自动装上的 @lobehub/ui@5
#      会拖入仅支持 react<=18 的 @emoji-mart/react（安装期 ERESOLVE 警告）与已弃用的
#      intersection-observer。
#   2) 跳过 peer 冲突解析 → 安装期不再输出 ERESOLVE 警告。
# 注意：webui 其余真实 peer（react/react-dom/three/vite/pdfjs-dist 等）均为直接依赖，不受影响。
legacy-peer-deps=true

# 与根目录保持一致，供 postinstall 在 webui/ 内安装时使用
registry=https://registry.npmjs.org/
