{
  "name": "@solo-thinker/moss",
  "version": "1.2.0",
  "description": "MOSS - 微内核 + 模块化架构的 AI Agent 应用",
  "type": "module",
  "bin": {
    "moss": "bin/moss.js"
  },
  "files": [
    "dist/",
    "config/",
    "bin/",
    "skills/",
    "mcps/",
    "agent/",
    "browser-extension/"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:direct": "node scripts/dev.mjs",
    "postinstall": "node scripts/install-webui.mjs",
    "build": "node scripts/build.mjs",
    "build:ui": "cd webui && npm run build",
    "build:backend": "bun build src/main.ts --outfile dist/server.js --target bun --external sherpa-onnx-node --external sharp --external @tencent-connect/qqbot-nodejs --external @tencent-connect/qqbot-connector",
    "start": "bun src/main.ts start --foreground",
    "start:daemon": "bun src/main.ts start",
    "stop": "bun src/main.ts stop",
    "status": "bun src/main.ts status",
    "restart": "bun src/main.ts restart",
    "update": "bun src/main.ts update",
    "version": "bun src/main.ts version",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns \"研究/**\" --path-ignore-patterns \"webui/**\"",
    "test:terminal": "bun test src/modules/tools/terminal",
    "test:watch": "bun test --watch --path-ignore-patterns \"研究/**\" --path-ignore-patterns \"webui/**\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@puppeteer/browsers": "^3.2.6",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "cfb": "^1.2.2",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.3",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "officeparser": "^8.4.1",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.5",
    "sherpa-onnx-node": "^1.13.8",
    "tar": "^7.5.22",
    "trash": "^10.1.1",
    "tree-sitter-wasm": "^2.0.4",
    "unbzip2-stream": "^1.4.3",
    "web-tree-sitter": "^0.27.1",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/unbzip2-stream": "^1.4.3",
    "bun-types": "^1.4.4",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.16",
    "qs": "^6.17.1",
    "body-parser": "^2.4.0",
    "proxy-addr": "^2.0.8",
    "ip-address": "^10.7.5",
    "fast-uri": "^3.1.9",
    "undici": "^7.30.1",
    "mammoth": {
      "@xmldom/xmldom": "0.8.15"
    }
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "allowScripts": {
    "tesseract.js": false
  }
}
